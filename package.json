{
  "name": "streamgrab",
  "version": "1.1.2",
  "description": "Universal video downloader for HLS, DASH, YouTube and other supported sources.",
  "author": {
    "name": "Kaique Albuquerque",
    "email": "kaique.g.dias14@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kaique-albuquerque/streamgrab.git"
  },
  "bugs": {
    "url": "https://github.com/kaique-albuquerque/streamgrab/issues"
  },
  "homepage": "https://github.com/kaique-albuquerque/streamgrab#readme",
  "type": "module",
  "main": "electron/main.js",
  "bin": {
    "streamgrab": "bin/streamgrab.mjs"
  },
  "files": [
    "bin/**",
    "src/**",
    "scripts/**",
    "electron/**",
    "config.example.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "analyze": "node bin/streamgrab.mjs analyze",
    "audit": "npm audit --omit=dev 2>&1 || echo '[audit] Vulnerabilities found — review above'",
    "curl:install": "node scripts/install-curl-impersonate.mjs",
    "dist": "npm run pack:resources && electron-builder --win",
    "dist:dir": "npm run pack:resources && electron-builder --win --dir",
    "dist:linux": "npm run pack:resources && electron-builder --linux",
    "dist:mac": "npm run pack:resources && electron-builder --mac",
    "dist:mac:dir": "npm run pack:resources && electron-builder --mac --dir",
    "docker": "node scripts/docker-menu.mjs",
    "docker:build": "docker-compose build",
    "docker:cli": "docker-compose run --rm streamgrab",
    "docker:help": "docker-compose run --rm streamgrab help",
    "download": "node bin/streamgrab.mjs download",
    "download:curl": "node src/index.js --curl-impersonate",
    "download:turbo": "node src/index.js --turbo",
    "download:turbo:smart": "node src/index.js --turbo --smart-turbo",
    "download:youtube": "node src/index.js --youtube",
    "electron:dev": "electron .",
    "electron:install": "node scripts/install-electron.mjs",
    "ffmpeg:install": "node scripts/install-ffmpeg.mjs",
    "format": "prettier --write .",
    "git": "node scripts/git-menu.mjs",
    "git:workflow": "node scripts/git-workflow.mjs",
    "lint": "eslint .",
    "pack:resources": "node scripts/update-ytdlp.mjs && node scripts/package-resources.mjs",
    "postinstall": "node scripts/install-ffmpeg.mjs && node scripts/install-electron.mjs",
    "release": "npm run pack:resources && electron-builder --win --mac --linux && node scripts/checksums.mjs",
    "streamgrab": "node bin/streamgrab.mjs",
    "test": "node --experimental-test-module-mocks --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\" && node tests/e2e/curl-e2e.mjs",
    "test:e2e": "node tests/e2e/curl-e2e.mjs",
    "test:integration": "node --experimental-test-module-mocks --test \"tests/integration/*.test.js\"",
    "test:unit": "node --experimental-test-module-mocks --test \"tests/unit/*.test.js\"",
    "update:ytdlp": "node scripts/update-ytdlp.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "streamgrab",
    "video",
    "downloader",
    "hls",
    "dash",
    "youtube",
    "yt-dlp",
    "ffmpeg",
    "curl-impersonate",
    "mdstrm",
    "mediastream",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "ntl": "^5.1.0",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "youtube-dl-exec": "^3.1.12"
  },
  "allowScripts": {
    "youtube-dl-exec@3.1.12": true,
    "electron@37.10.3": true
  }
}
